# Copy this file to edgedash/.env and fill in your keys.
# edgedash/.env is gitignored — never commit real keys.

# Google Gemini (required when llm_provider = "gemini")
GEMINI_API_KEY=

# Apify token (required when source list includes "apify")
APIFY_TOKEN=

# Ollama base URL (optional — only needed when llm_provider = "ollama")
# OLLAMA_URL=http://localhost:11434/api/generate
